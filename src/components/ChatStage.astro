---
import { Image } from "astro:assets";
import { useTranslations, useTranslatedPath, type Lang } from "../i18n/utils";
import avatarImg from "../assets/images/card-front.png";
import { PROFILE_DATA } from "../data/profile";

interface Props {
  lang: Lang;
  apiUrl?: string;
}

const {
  lang,
  apiUrl = import.meta.env.PUBLIC_CHATBOT_API_URL ||
    "http://localhost:3000/api/chat",
} = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const isVi = lang === "vi";

// Quick prompt suggestions from centralized PROFILE_DATA
const quickPrompts = isVi
  ? PROFILE_DATA.quickPrompts.vi
  : PROFILE_DATA.quickPrompts.en;

const initialTime = new Date().toLocaleTimeString("en-US", {
  hour: "2-digit",
  minute: "2-digit",
});
---

<div
  class="chat-pure-root relative w-full h-[calc(100dvh-1.5rem)] sm:h-[calc(100dvh-3rem)] max-w-4xl mx-auto my-2 sm:my-4 flex flex-col text-slate-800 dark:text-slate-100 selection:bg-blue-500/20"
  data-lang={lang}
  data-api-url={apiUrl}
  data-avatar-url={avatarImg.src}
>
  <!-- Subtle Atmospheric Backdrop -->
  <div
    class="absolute inset-0 pointer-events-none overflow-hidden -z-10 rounded-3xl"
  >
    <div
      class="absolute top-10 left-1/2 -translate-x-1/2 w-[550px] h-[300px] bg-gradient-to-tr from-blue-600/10 via-indigo-500/10 to-purple-600/10 rounded-full blur-[100px] dark:from-blue-500/15 dark:via-cyan-500/10 dark:to-purple-600/15"
    >
    </div>
  </div>

  <!-- Dedicated Chat Terminal Shell (Full Height Pure Chat) -->
  <div
    class="chat-terminal-shell relative flex-1 rounded-2xl sm:rounded-3xl border border-black/10 dark:border-white/10 bg-white/80 dark:bg-[#0c101c]/90 backdrop-blur-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] dark:shadow-[0_25px_70px_-15px_rgba(0,0,0,0.7)] overflow-hidden flex flex-col"
  >
    <!-- Top Header Bar of the Chat -->
    <header
      class="chat-top-header flex items-center justify-between px-4 sm:px-6 py-3.5 border-b border-black/5 dark:border-white/10 bg-slate-50/60 dark:bg-white/[0.02]"
    >
      <!-- Left: Back Button & Persona Identity -->
      <div class="flex items-center gap-3">
        <a
          href={translatePath("/")}
          class="back-btn group w-9 h-9 rounded-full flex items-center justify-center border border-black/10 dark:border-white/15 bg-white/80 dark:bg-slate-900/80 hover:bg-blue-500/10 hover:border-blue-500/40 transition-all text-slate-700 dark:text-slate-200"
          title={t("chat.backHome")}
          aria-label={t("chat.backHome")}
        >
          <span
            class="transition-transform duration-200 group-hover:-translate-x-0.5 text-sm"
            >←</span
          >
        </a>

        <!-- Avatar & Info -->
        <div class="flex items-center gap-2.5">
          <div
            class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden border border-blue-500/40 p-0.5 bg-gradient-to-tr from-blue-600 to-indigo-600 flex-shrink-0"
          >
            <Image
              src={avatarImg}
              alt="Thái Tín Khang"
              class="w-full h-full object-cover rounded-full"
              width={80}
              height={80}
            />
            <span
              class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 border-2 border-white dark:border-[#0c101c]"
            ></span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1
                class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight"
              >
                Thái Tín Khang
              </h1>
              <span
                class="px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-blue-500/10 text-blue-600 dark:text-blue-400"
              >
                AI BOT
              </span>
            </div>
            <p
              class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1 leading-tight mt-0.5"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span>{isVi ? "Trực tuyến " : "Online "}</span>
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- Scrollable Messages Container -->
    <div
      id="chat-messages-container"
      class="chat-messages-body flex-1 overflow-y-auto px-4 sm:px-6 py-6 space-y-4 scroll-smooth"
    >
      <!-- Date Divider -->
      <div class="chat-timestamp flex items-center justify-center my-2">
        <span
          class="px-3 py-1 rounded-full text-[11px] font-mono bg-black/5 dark:bg-white/5 text-slate-400 dark:text-slate-500 border border-black/5 dark:border-white/5"
        >
          {
            isVi
              ? "Hôm nay • Phiên trò chuyện tương tác"
              : "Today • Live Interactive Session"
          }
        </span>
      </div>

      <!-- Bot Welcome Bubble 1 -->
      <div class="msg-row bot-row flex items-start gap-3">
        <div
          class="bot-avatar-mini w-8 h-8 rounded-full overflow-hidden flex-shrink-0 border border-blue-500/30"
        >
          <Image
            src={avatarImg}
            alt="Avatar"
            class="w-full h-full object-cover"
            width={64}
            height={64}
          />
        </div>
        <div class="msg-bubble-group max-w-[85%] sm:max-w-[75%] space-y-1">
          <div
            class="msg-bubble bot-bubble p-4 rounded-2xl rounded-tl-sm bg-slate-100 dark:bg-slate-800/80 border border-black/5 dark:border-white/10 text-sm leading-relaxed text-slate-800 dark:text-slate-200 shadow-sm relative group"
          >
            <p>
              {
                isVi
                  ? PROFILE_DATA.welcomeIntro.vi
                  : PROFILE_DATA.welcomeIntro.en
              }
            </p>
          </div>
          <span
            class="chat-initial-time text-[10px] text-slate-400 dark:text-slate-500 font-mono ml-1"
            >{initialTime}</span
          >
        </div>
      </div>

      <!-- Bot Welcome Bubble 2: Tech Stack, Experience, Education, Certificate, Contact Email -->
      <div class="msg-row bot-row flex items-start gap-3">
        <div
          class="bot-avatar-mini w-8 h-8 rounded-full overflow-hidden flex-shrink-0 border border-blue-500/30"
        >
          <Image
            src={avatarImg}
            alt="Avatar"
            class="w-full h-full object-cover"
            width={64}
            height={64}
          />
        </div>
        <div class="msg-bubble-group max-w-[90%] sm:max-w-[82%] space-y-1">
          <div
            class="msg-bubble bot-bubble p-4 rounded-2xl rounded-tl-sm bg-slate-100 dark:bg-slate-800/80 border border-black/5 dark:border-white/10 text-sm leading-relaxed text-slate-800 dark:text-slate-200 shadow-sm space-y-2.5"
          >
            <p class="font-semibold text-slate-900 dark:text-white">
              {
                isVi
                  ? PROFILE_DATA.overviewTitle.vi
                  : PROFILE_DATA.overviewTitle.en
              }
            </p>
            <div
              class="space-y-2 text-xs sm:text-sm pt-1 border-t border-black/5 dark:border-white/10"
            >
              <div
                class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2"
              >
                <span
                  class="font-semibold text-blue-600 dark:text-blue-400 min-w-[130px] flex-shrink-0 pt-0.5"
                  >🛠️ {isVi ? "Kỹ năng chuyên môn:" : "Technical Skills:"}</span
                >
                <div
                  class="space-y-1.5 text-slate-700 dark:text-slate-300 flex-1 leading-relaxed text-xs sm:text-sm"
                >
                  {
                    PROFILE_DATA.skills.map((skill) => (
                      <div>
                        <strong class="text-slate-900 dark:text-white font-medium">
                          {isVi ? skill.label.vi : skill.label.en}
                        </strong>
                        <span> {isVi ? skill.text.vi : skill.text.en}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
              <div
                class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2"
              >
                <span
                  class="font-semibold text-blue-600 dark:text-blue-400 min-w-[130px] flex-shrink-0 pt-0.5"
                  >💼 Work Experience:</span
                >
                <div
                  class="space-y-1 text-slate-700 dark:text-slate-300 flex-1"
                >
                  {
                    PROFILE_DATA.experience.map((exp) => (
                      <div>
                        <strong class="text-slate-900 dark:text-white font-medium">
                          {isVi ? exp.period.vi : exp.period.en}:
                        </strong>
                        <span>
                          {" "}
                          {isVi ? exp.role.vi : exp.role.en} (
                          {isVi ? exp.description.vi : exp.description.en})
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
              <div
                class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2"
              >
                <span
                  class="font-semibold text-blue-600 dark:text-blue-400 min-w-[130px] flex-shrink-0"
                  >🎓 Education:</span
                >
                <span class="text-slate-700 dark:text-slate-300">
                  <strong class="text-slate-900 dark:text-white font-medium"
                    >{PROFILE_DATA.education.period}:</strong
                  >
                  {" "}
                  {
                    isVi
                      ? PROFILE_DATA.education.formatted.vi
                      : PROFILE_DATA.education.formatted.en
                  }
                </span>
              </div>
              <div
                class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-2 pt-0.5"
              >
                <span
                  class="font-semibold text-blue-600 dark:text-blue-400 min-w-[130px] flex-shrink-0 pt-1"
                  >📜 {isVi ? "Chứng chỉ Google:" : "Certifications:"}</span
                >
                <div class="space-y-2 flex-1 w-full">
                  {
                    PROFILE_DATA.certificates.map((cert) => (
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-2.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/5 dark:border-white/5 transition-colors hover:border-blue-500/30">
                        <div class="min-w-0 flex-1">
                          <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-medium text-slate-900 dark:text-white text-xs sm:text-sm">
                              {cert.shortTitle}
                            </span>
                            <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-medium bg-blue-500/10 text-blue-600 dark:text-blue-400">
                              {cert.issueDate}
                            </span>
                          </div>
                          <p class="text-[11px] text-slate-500 dark:text-slate-400 font-mono mt-0.5">
                            ID: {cert.credentialId} • {cert.issuer}
                          </p>
                        </div>
                        <a
                          href={cert.verifyUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500/20 transition-all shadow-2xs self-start sm:self-auto shrink-0"
                          title={
                            isVi
                              ? `Xác thực chứng chỉ Coursera: ${cert.credentialId}`
                              : `Verify credential: ${cert.credentialId}`
                          }
                        >
                          <span>✓ {isVi ? "Xác thực" : "Verify"}</span>
                          <span>↗</span>
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
              <div
                class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2"
              >
                <span
                  class="font-semibold text-blue-600 dark:text-blue-400 min-w-[130px] flex-shrink-0"
                  >✉️ Contact Email:</span
                >
                <a
                  href={`mailto:${PROFILE_DATA.email}`}
                  class="text-blue-600 dark:text-blue-400 hover:underline font-mono font-medium"
                  >{PROFILE_DATA.email}</a
                >
              </div>
            </div>
          </div>
          <span
            class="chat-initial-time text-[10px] text-slate-400 dark:text-slate-500 font-mono ml-1"
            >{initialTime}</span
          >
        </div>
      </div>

      <!-- Realtime dynamic messages appended here -->
      <div id="dynamic-messages" class="space-y-4"></div>

      <!-- Animated Typing Indicator (GSAP Bouncing Dots) -->
      <div
        id="typing-indicator"
        class="msg-row bot-row flex items-start gap-3 hidden opacity-0"
      >
        <div
          class="bot-avatar-mini w-8 h-8 rounded-full overflow-hidden flex-shrink-0 border border-blue-500/30"
        >
          <Image
            src={avatarImg}
            alt="Avatar"
            class="w-full h-full object-cover"
            width={64}
            height={64}
          />
        </div>
        <div
          class="typing-bubble px-4 py-3 rounded-2xl rounded-tl-sm bg-slate-100 dark:bg-slate-800/80 border border-black/5 dark:border-white/10 flex items-center gap-1.5 shadow-sm"
        >
          <span class="typing-dot w-2 h-2 rounded-full bg-blue-500"></span>
          <span class="typing-dot w-2 h-2 rounded-full bg-blue-500"></span>
          <span class="typing-dot w-2 h-2 rounded-full bg-blue-500"></span>
          <span class="text-xs text-slate-400 font-mono ml-2">
            {isVi ? "Khang đang phản hồi..." : "Khang is typing..."}
          </span>
        </div>
      </div>
    </div>

    <!-- Quick Prompt Pills Carousel -->
    <div
      class="chat-quick-prompts px-4 sm:px-6 py-2 bg-slate-50/70 dark:bg-white/[0.02] border-t border-black/5 dark:border-white/10 overflow-x-auto no-scrollbar flex items-center gap-2"
    >
      <span
        class="text-[10px] font-mono text-slate-400 uppercase tracking-wider flex-shrink-0 mr-1"
      >
        {isVi ? "Gợi ý:" : "Prompts:"}
      </span>
      {
        quickPrompts.map((item) => (
          <button
            type="button"
            class="prompt-chip flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-medium border border-black/10 dark:border-white/15 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-blue-500 hover:bg-blue-500/10 hover:text-blue-600 dark:hover:text-blue-400 transition-all cursor-pointer whitespace-nowrap active:scale-95 shadow-xs"
            data-prompt={item.prompt}
            data-id={item.id}
          >
            {item.label}
          </button>
        ))
      }
    </div>

    <!-- Chat Input Bar -->
    <div
      class="chat-input-bar px-4 sm:px-6 py-3 bg-white/90 dark:bg-[#0c101c]/95 border-t border-black/5 dark:border-white/10 backdrop-blur-xl"
    >
      <form id="chat-form" class="flex items-center gap-2 relative">
        <!-- Emoji trigger button -->
        <div class="relative">
          <button
            id="emoji-picker-toggle"
            type="button"
            class="w-10 h-10 rounded-full flex items-center justify-center text-slate-500 hover:text-blue-500 hover:bg-black/5 dark:hover:bg-white/5 transition-all text-lg cursor-pointer"
            title="Send emoji reaction"
          >
            ✨
          </button>
          <!-- Floating emoji menu -->
          <div
            id="emoji-popup"
            class="hidden absolute bottom-12 left-0 p-2 rounded-2xl bg-white dark:bg-slate-900 border border-black/10 dark:border-white/10 shadow-xl flex items-center gap-1.5 z-30"
          >
            <button
              type="button"
              class="quick-emoji text-xl hover:scale-130 transition-transform p-1 cursor-pointer"
              data-emoji="🔥">🔥</button
            >
            <button
              type="button"
              class="quick-emoji text-xl hover:scale-130 transition-transform p-1 cursor-pointer"
              data-emoji="🚀">🚀</button
            >
            <button
              type="button"
              class="quick-emoji text-xl hover:scale-130 transition-transform p-1 cursor-pointer"
              data-emoji="❤️">❤️</button
            >
            <button
              type="button"
              class="quick-emoji text-xl hover:scale-130 transition-transform p-1 cursor-pointer"
              data-emoji="👏">👏</button
            >
            <button
              type="button"
              class="quick-emoji text-xl hover:scale-130 transition-transform p-1 cursor-pointer"
              data-emoji="💯">💯</button
            >
          </div>
        </div>

        <!-- Input text field -->
        <div class="flex-1 relative">
          <input
            id="chat-user-input"
            type="text"
            placeholder={t("chat.inputPlaceholder")}
            autocomplete="off"
            class="w-full px-4 py-2.5 rounded-full bg-slate-100/80 dark:bg-slate-800/60 border border-transparent focus:border-blue-500 focus:bg-white dark:focus:bg-slate-800 focus:outline-none text-sm text-slate-800 dark:text-slate-100 placeholder:text-slate-400 transition-all shadow-inner"
          />
        </div>

        <!-- Send Button with GSAP spring action -->
        <button
          id="chat-send-btn"
          type="submit"
          class="send-btn inline-flex items-center justify-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-medium text-sm transition-all shadow-md shadow-blue-600/30 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed group active:scale-95"
        >
          <span class="hidden sm:inline">{t("chat.send")}</span>
          <span
            class="send-arrow transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            >➤</span
          >
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  /* Custom scrollbar suppression for horizontal prompt list */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .msg-row {
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from "gsap";
  import {
    streamChat,
    renderMarkdown,
    escapeHtml,
    type ChatMessage,
  } from "../utils/chatbotApi";

  // Sound Synthesizer using Web Audio API
  class SimpleAudioFx {
    private ctx: AudioContext | null = null;
    public enabled: boolean = true;

    private getContext(): AudioContext | null {
      if (!this.enabled) return null;
      if (!this.ctx && typeof window !== "undefined") {
        const AudioCtx =
          window.AudioContext || (window as any).webkitAudioContext;
        if (AudioCtx) this.ctx = new AudioCtx();
      }
      if (this.ctx && this.ctx.state === "suspended") {
        this.ctx.resume();
      }
      return this.ctx;
    }

    playSend() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(540, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.13);
      } catch (e) {}
    }

    playReceive() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(700, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(420, ctx.currentTime + 0.18);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.19);
      } catch (e) {}
    }

    playReaction() {
      const ctx = this.getContext();
      if (!ctx) return;
      try {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(800, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(
          1200,
          ctx.currentTime + 0.15,
        );
        gain.gain.setValueAtTime(0.07, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.16);
      } catch (e) {}
    }
  }

  const audioFx = new SimpleAudioFx();

  function initChatPage() {
    const rootEl = document.querySelector(".chat-pure-root") as HTMLElement;
    if (!rootEl) return;
    if (rootEl.dataset.initialized === "true") return;
    rootEl.dataset.initialized = "true";

    const currentNow = new Date().toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit",
    });
    rootEl.querySelectorAll(".chat-initial-time").forEach((el) => {
      el.textContent = currentNow;
    });

    const apiUrl =
      rootEl.getAttribute("data-api-url") || "http://localhost:3000/api/chat";
    const avatarUrl = rootEl.getAttribute("data-avatar-url") || "/favicon.svg";
    const isViLocale = rootEl.getAttribute("data-lang") === "vi";

    // Framework scoping via gsap.context
    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia();

      mm.add(
        {
          isNormal: "(prefers-reduced-motion: no-preference)",
          isReduced: "(prefers-reduced-motion: reduce)",
        },
        (context) => {
          const { isReduced } = context.conditions as {
            isNormal: boolean;
            isReduced: boolean;
          };

          // ----------------------------------------------------
          // 1. Initial Intro Entrance Timeline (gsap-core)
          // ----------------------------------------------------
          const initialBubbles = rootEl.querySelectorAll(
            ".chat-messages-body > .msg-row",
          );
          const quickChips = rootEl.querySelectorAll(".prompt-chip");

          const introTl = gsap.timeline({
            defaults: { ease: "back.out(1.4)" },
          });

          if (!isReduced) {
            introTl.from(initialBubbles, {
              y: 24,
              scale: 0.95,
              autoAlpha: 0,
              duration: 0.5,
              stagger: 0.16,
              clearProps: "transform,visibility,opacity",
            });

            introTl.from(
              quickChips,
              {
                scale: 0.8,
                autoAlpha: 0,
                y: 10,
                stagger: 0.05,
                duration: 0.35,
                ease: "power2.out",
                clearProps: "transform,visibility,opacity",
              },
              "-=0.2",
            );
          } else {
            gsap.from(initialBubbles, { autoAlpha: 0, duration: 0.2 });
          }

          // ----------------------------------------------------
          // 2. Typing Indicator Dots Animation (Infinite Loop)
          // ----------------------------------------------------
          const typingDots = rootEl.querySelectorAll(".typing-dot");
          if (typingDots.length) {
            gsap.to(typingDots, {
              y: -5,
              duration: 0.35,
              repeat: -1,
              yoyo: true,
              stagger: 0.12,
              ease: "sine.inOut",
            });
          }

          // ----------------------------------------------------
          // 3. Interactive Realtime Chat Engine with /api/chat
          // ----------------------------------------------------
          const chatForm = rootEl.querySelector(
            "#chat-form",
          ) as HTMLFormElement;
          const userInput = rootEl.querySelector(
            "#chat-user-input",
          ) as HTMLInputElement;
          const dynamicContainer = rootEl.querySelector(
            "#dynamic-messages",
          ) as HTMLElement;
          const messagesScroll = rootEl.querySelector(
            "#chat-messages-container",
          ) as HTMLElement;
          const typingIndicator = rootEl.querySelector(
            "#typing-indicator",
          ) as HTMLElement;
          const sendBtn = rootEl.querySelector("#chat-send-btn") as HTMLElement;

          const conversationHistory: ChatMessage[] = [];
          let isStreaming = false;
          let currentAbortController: AbortController | null = null;

          function scrollToBottom() {
            if (!messagesScroll) return;
            gsap.to(messagesScroll, {
              scrollTop: messagesScroll.scrollHeight + 140,
              duration: 0.3,
              ease: "power2.out",
            });
          }

          function createMsgBubble(text: string, isUser: boolean) {
            const row = document.createElement("div");
            row.className = `msg-row ${isUser ? "user-row flex justify-end" : "bot-row flex items-start gap-3"}`;
            const nowTime = new Date().toLocaleTimeString([], {
              hour: "2-digit",
              minute: "2-digit",
            });

            if (isUser) {
              row.innerHTML = `
                <div class="msg-bubble-group max-w-[85%] sm:max-w-[75%] space-y-1 text-right">
                  <div class="msg-bubble user-bubble p-4 rounded-2xl rounded-tr-sm bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-sm leading-relaxed shadow-md shadow-blue-500/20 text-left">
                    <p class="whitespace-pre-wrap">${escapeHtml(text)}</p>
                  </div>
                  <span class="text-[10px] text-slate-400 font-mono mr-1">${nowTime}</span>
                </div>
              `;
            } else {
              row.innerHTML = `
                <div class="bot-avatar-mini w-8 h-8 rounded-full overflow-hidden flex-shrink-0 border border-blue-500/30">
                  <img src="${avatarUrl}" alt="Avatar" class="w-full h-full object-cover" />
                </div>
                <div class="msg-bubble-group max-w-[88%] sm:max-w-[80%] space-y-1">
                  <div class="msg-bubble bot-bubble p-4 rounded-2xl rounded-tl-sm bg-slate-100 dark:bg-slate-800/80 border border-black/5 dark:border-white/10 text-sm leading-relaxed text-slate-800 dark:text-slate-200 shadow-sm">
                    <div class="bot-content space-y-2">${renderMarkdown(text)}</div>
                  </div>
                  <span class="text-[10px] text-slate-400 font-mono ml-1">${nowTime}</span>
                </div>
              `;
            }

            dynamicContainer.appendChild(row);

            if (!isReduced) {
              gsap.from(row, {
                y: 18,
                x: isUser ? 20 : -20,
                scale: 0.95,
                autoAlpha: 0,
                duration: 0.35,
                ease: "back.out(1.5)",
              });
            } else {
              gsap.from(row, { autoAlpha: 0, duration: 0.2 });
            }

            scrollToBottom();
          }

          function createBotStreamingBubble() {
            const row = document.createElement("div");
            row.className = "msg-row bot-row flex items-start gap-3";
            const nowTime = new Date().toLocaleTimeString([], {
              hour: "2-digit",
              minute: "2-digit",
            });

            row.innerHTML = `
              <div class="bot-avatar-mini w-8 h-8 rounded-full overflow-hidden flex-shrink-0 border border-blue-500/30">
                <img src="${avatarUrl}" alt="Avatar" class="w-full h-full object-cover" />
              </div>
              <div class="msg-bubble-group max-w-[88%] sm:max-w-[80%] space-y-1">
                <div class="msg-bubble bot-bubble p-4 rounded-2xl rounded-tl-sm bg-slate-100 dark:bg-slate-800/80 border border-black/5 dark:border-white/10 text-sm leading-relaxed text-slate-800 dark:text-slate-200 shadow-sm">
                  <div class="bot-content space-y-2"></div>
                </div>
                <div class="flex items-center gap-2 ml-1">
                  <span class="text-[10px] text-slate-400 font-mono">${nowTime}</span>
                  <span class="streaming-pulse inline-flex items-center gap-1 text-[10px] text-blue-500 font-mono">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
                    ${isViLocale ? "AI đang soạn..." : "AI streaming..."}
                  </span>
                </div>
              </div>
            `;

            dynamicContainer.appendChild(row);

            if (!isReduced) {
              gsap.from(row, {
                y: 15,
                x: -15,
                scale: 0.95,
                autoAlpha: 0,
                duration: 0.35,
                ease: "back.out(1.4)",
              });
            }

            const contentEl = row.querySelector(".bot-content") as HTMLElement;
            const pulseEl = row.querySelector(
              ".streaming-pulse",
            ) as HTMLElement;

            return { row, contentEl, pulseEl };
          }

          async function handleUserSubmit(userText: string) {
            const trimmed = userText.trim();
            if (isStreaming || !trimmed) return;

            isStreaming = true;

            // Lock controls
            if (sendBtn) {
              sendBtn.setAttribute("disabled", "true");
              sendBtn.classList.add("opacity-50", "cursor-not-allowed");
              gsap.fromTo(
                sendBtn,
                { scale: 0.88 },
                { scale: 1, duration: 0.35, ease: "elastic.out(1.2, 0.4)" },
              );
            }
            if (userInput) {
              userInput.setAttribute("disabled", "true");
              userInput.placeholder = isViLocale
                ? "Trợ lý AI đang phản hồi..."
                : "AI assistant is typing...";
            }

            // Audio FX
            audioFx.playSend();

            // Insert User Message
            createMsgBubble(trimmed, true);

            // Add to conversation history
            conversationHistory.push({ role: "user", content: trimmed });

            // Show Typing indicator with GSAP
            if (typingIndicator) {
              typingIndicator.classList.remove("hidden");
              gsap.to(typingIndicator, {
                autoAlpha: 1,
                y: 0,
                duration: 0.25,
                ease: "power2.out",
              });
              scrollToBottom();
            }

            let botBubble: ReturnType<typeof createBotStreamingBubble> | null =
              null;
            let fullReply = "";
            let receivedFirstToken = false;

            currentAbortController = new AbortController();

            await streamChat({
              apiUrl,
              messages: conversationHistory,
              signal: currentAbortController.signal,
              onToken: (token) => {
                if (!receivedFirstToken) {
                  receivedFirstToken = true;
                  if (typingIndicator) {
                    gsap.to(typingIndicator, {
                      autoAlpha: 0,
                      duration: 0.15,
                      onComplete: () => typingIndicator.classList.add("hidden"),
                    });
                  }
                  audioFx.playReceive();
                  botBubble = createBotStreamingBubble();
                }

                fullReply += token;
                if (botBubble) {
                  botBubble.contentEl.innerHTML = renderMarkdown(fullReply);
                  scrollToBottom();
                }
              },
              onDone: () => {
                if (typingIndicator) {
                  typingIndicator.classList.add("hidden");
                  gsap.set(typingIndicator, { autoAlpha: 0 });
                }

                if (botBubble) {
                  botBubble.pulseEl?.remove();

                  if (fullReply.trim()) {
                    conversationHistory.push({
                      role: "assistant",
                      content: fullReply.trim(),
                    });
                  }
                }

                cleanupStreamingState();
              },
              onError: (errorMsg) => {
                if (typingIndicator) {
                  typingIndicator.classList.add("hidden");
                  gsap.set(typingIndicator, { autoAlpha: 0 });
                }

                if (!receivedFirstToken) {
                  createMsgBubble(`⚠️ ${errorMsg}`, false);
                } else if (botBubble) {
                  botBubble.pulseEl?.remove();
                  botBubble.contentEl.innerHTML += `<p class="mt-2 text-rose-500 font-medium text-xs">⚠️ ${escapeHtml(errorMsg)}</p>`;
                }

                cleanupStreamingState();
              },
            });

            function cleanupStreamingState() {
              isStreaming = false;
              currentAbortController = null;
              if (sendBtn) {
                sendBtn.removeAttribute("disabled");
                sendBtn.classList.remove("opacity-50", "cursor-not-allowed");
              }
              if (userInput) {
                userInput.removeAttribute("disabled");
                userInput.placeholder = isViLocale
                  ? "Nhập tin nhắn..."
                  : "Type a message...";
                userInput.focus();
              }
              scrollToBottom();
            }
          }

          if (chatForm && userInput) {
            chatForm.addEventListener("submit", (e) => {
              e.preventDefault();
              const text = userInput.value.trim();
              if (!text) return;
              userInput.value = "";
              handleUserSubmit(text);
            });
          }

          // Suggestion Prompt Chips Click
          rootEl.querySelectorAll(".prompt-chip").forEach((chip) => {
            chip.addEventListener("click", () => {
              if (isStreaming) return;
              const prompt =
                chip.getAttribute("data-prompt") ||
                chip.textContent?.trim() ||
                "";
              handleUserSubmit(prompt);
            });
          });

          // Floating Reaction Physics
          function spawnFloatingReaction(originEl: HTMLElement, emoji: string) {
            audioFx.playReaction();
            const rect = originEl.getBoundingClientRect();
            const particle = document.createElement("div");
            particle.textContent = emoji;
            particle.className =
              "fixed pointer-events-none z-50 text-2xl select-none";
            particle.style.left = `${rect.left + rect.width / 2}px`;
            particle.style.top = `${rect.top}px`;
            document.body.appendChild(particle);

            gsap.fromTo(
              particle,
              { scale: 0.6, autoAlpha: 1, y: 0, x: 0 },
              {
                y: gsap.utils.random(-80, -120),
                x: gsap.utils.random(-30, 30),
                scale: 1.6,
                rotation: gsap.utils.random(-25, 25),
                autoAlpha: 0,
                duration: 1,
                ease: "power2.out",
                onComplete: () => particle.remove(),
              },
            );
          }

          // Emoji Tray Popup
          const emojiToggle = rootEl.querySelector(
            "#emoji-picker-toggle",
          ) as HTMLElement;
          const emojiPopup = rootEl.querySelector(
            "#emoji-popup",
          ) as HTMLElement;
          if (emojiToggle && emojiPopup) {
            emojiToggle.addEventListener("click", (e) => {
              e.stopPropagation();
              const isHidden = emojiPopup.classList.contains("hidden");
              if (isHidden) {
                emojiPopup.classList.remove("hidden");
                gsap.fromTo(
                  emojiPopup,
                  { scale: 0.8, autoAlpha: 0, y: 10 },
                  {
                    scale: 1,
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.25,
                    ease: "back.out(1.5)",
                  },
                );
              } else {
                gsap.to(emojiPopup, {
                  scale: 0.8,
                  autoAlpha: 0,
                  duration: 0.15,
                  onComplete: () => emojiPopup.classList.add("hidden"),
                });
              }
            });

            document.addEventListener("click", () => {
              if (!emojiPopup.classList.contains("hidden")) {
                emojiPopup.classList.add("hidden");
              }
            });

            emojiPopup.querySelectorAll(".quick-emoji").forEach((btn) => {
              btn.addEventListener("click", () => {
                const emoji = btn.getAttribute("data-emoji") || "🔥";
                spawnFloatingReaction(btn as HTMLElement, emoji);
                if (userInput) {
                  userInput.value += ` ${emoji}`;
                  userInput.focus();
                }
              });
            });
          }
        },
      );
    }, rootEl);

    // Astro lifecycle teardown on navigation (prevent memory leaks)
    document.addEventListener(
      "astro:before-swap",
      () => {
        rootEl.dataset.initialized = "false";
        ctx.revert();
      },
      { once: true },
    );
  }

  // Robust initialization
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initChatPage);
  } else {
    initChatPage();
  }
  document.addEventListener("astro:page-load", initChatPage);
</script>
