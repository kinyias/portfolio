---
import { getLangFromUrl, getCleanPath, useTranslatedPath, type Lang } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const cleanPath = getCleanPath(Astro.url);

// Ngôn ngữ đích chuyển sang khi bấm (One-Tap Toggle)
const targetLang: Lang = currentLang === 'en' ? 'vi' : 'en';
const translatePath = useTranslatedPath(targetLang);
const targetUrl = translatePath(cleanPath);
const targetTitle = targetLang === 'en' ? 'Switch to English' : 'Chuyển sang Tiếng Việt';

// Icon hiển thị tương ứng với hành động chuyển đổi:
// - Đang ở Tiếng Anh -> Hiện icon Ngôi sao Việt Nam (bấm để sang Tiếng Việt)
// - Đang ở Tiếng Việt -> Hiện icon Quả địa cầu Globe (bấm để sang Tiếng Anh / Quốc tế)
const isShowingStar = currentLang === 'en';
---

<a
  href={targetUrl}
  class="lang-icon-toggle"
  title={targetTitle}
  aria-label={targetTitle}
>
  {
    isShowingStar ? (
      <svg
        class="lang-icon icon-star"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
      </svg>
    ) : (
      <svg
        class="lang-icon icon-globe"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
        <path d="M2 12h20" />
      </svg>
    )
  }
</a>

<style>
  .lang-icon-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    background: transparent;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
  }

  .lang-icon-toggle:hover {
    color: var(--text-color);
    background: rgba(148, 163, 184, 0.15);
  }

  .lang-icon-toggle:active {
    transform: scale(0.92);
  }

  .lang-icon {
    width: 15px;
    height: 15px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hiệu ứng xoay nhẹ khi hover */
  .lang-icon-toggle:hover .lang-icon {
    transform: rotate(20deg) scale(1.08);
  }

  /* Điểm nhấn màu sắc tinh tế cho ngôi sao */
  .icon-star {
    opacity: 0.88;
  }

  .lang-icon-toggle:hover .icon-star {
    opacity: 1;
    color: #eab308;
  }
</style>
