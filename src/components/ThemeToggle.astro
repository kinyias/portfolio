---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button
  type="button"
  id="theme-single-toggle"
  class="theme-toggle-btn"
  title={t('theme.light')}
  aria-label="Toggle theme"
>
  <!-- Sun Icon (hiển thị khi Dark mode, click để đổi sang Light) -->
  <svg
    class="theme-icon icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (hiển thị khi Light mode, click để đổi sang Dark) -->
  <svg
    class="theme-icon icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  .theme-toggle-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    overflow: hidden;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--text-color);
    background: rgba(148, 163, 184, 0.15);
  }

  .theme-toggle-btn:active {
    transform: scale(0.92);
  }

  .theme-icon {
    position: absolute;
    width: 15px;
    height: 15px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  /* Light mode state: Moon visible, Sun hidden */
  :global(:root:not(.dark)) .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
    pointer-events: none;
  }

  :global(:root:not(.dark)) .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Dark mode state: Sun visible, Moon hidden */
  :global(.dark) .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.dark) .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
    pointer-events: none;
  }
</style>

<script>
  function setupSingleThemeToggle() {
    const btn = document.getElementById('theme-single-toggle');
    if (!btn) return;

    function isCurrentDark(): boolean {
      return document.documentElement.classList.contains('dark');
    }

    function updateAria(isDark: boolean) {
      btn?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      btn?.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
    }

    // Khởi tạo label chính xác theo theme hiện hành
    updateAria(isCurrentDark());

    // Single-click toggle action
    btn.addEventListener('click', () => {
      const isDark = isCurrentDark();
      const newTheme = isDark ? 'light' : 'dark';

      document.documentElement.classList.toggle('dark', !isDark);
      document.documentElement.setAttribute('data-theme', newTheme);
      document.documentElement.style.colorScheme = newTheme;
      localStorage.setItem('theme', newTheme);

      updateAria(!isDark);
    });

    // Đồng bộ storage khi mở nhiều tab
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') {
        const isDark = e.newValue === 'dark';
        document.documentElement.classList.toggle('dark', isDark);
        updateAria(isDark);
      }
    });
  }

  setupSingleThemeToggle();
  document.addEventListener('astro:page-load', setupSingleThemeToggle);
</script>
