---
import { Image } from 'astro:assets';
import cardFrontImg from '../assets/images/card-front.png';
import cardBackImg from '../assets/images/card-back.png';
import githubIcon from '../assets/images/social/github-logo-svgrepo-com.svg';
import linkedinIcon from '../assets/images/social/linkedin-1-svgrepo-com.svg';
import facebookIcon from '../assets/images/social/facebook-1-svgrepo-com.svg';
import youtubeIcon from '../assets/images/social/youtube-svgrepo-com.svg';

interface Props {
  className?: string;
  frontTag?: string;
  backTag?: string;
  initialFlipped?: boolean;
  socialLinks?: {
    github?: string;
    linkedin?: string;
    facebook?: string;
    youtube?: string;
  };
}

const {
  className = '',
  frontTag = 'DEVELOPER // CREATOR',
  backTag = 'TECH STACK // UNIVERSE',
  initialFlipped = false,
  socialLinks = {
    github: 'https://github.com/kinyias',
    linkedin: 'https://linkedin.com/in/kinyias',
    facebook: 'https://facebook.com/kinyias',
    youtube: 'https://youtube.com/@kinyias',
  },
} = Astro.props;

const resolvedSocials = {
  github: socialLinks?.github || 'https://github.com/kinyias',
  linkedin: socialLinks?.linkedin || 'https://linkedin.com/in/kinyias',
  facebook: socialLinks?.facebook || 'https://facebook.com/kinyias',
  youtube: socialLinks?.youtube || 'https://youtube.com/@kinyias',
};
---

<div
  class={`card-3d-root relative flex flex-col items-center justify-center ${className}`}
  data-initial-flipped={initialFlipped ? 'true' : 'false'}
>
  <!-- Perspective Container -->
  <div class="perspective-stage relative pt-8 pb-14 sm:pt-10 sm:pb-16 px-4 sm:px-6">
    
    <!-- Floating Anchor: GSAP executes levitation on this element -->
    <div class="floating-anchor relative cursor-pointer group">
      
      <!-- 3D Card Core: GSAP executes 3D tilt and 180deg flip -->
      <div class="card-3d-core relative w-[290px] sm:w-[330px] md:w-[360px] aspect-[9/16]">
        
        <!-- ================= FRONT FACE (Double-Bezel Architecture) ================= -->
        <div class="card-face card-face-front absolute inset-0">
          <!-- Outer Shell (Machined Aluminum / Obsidian Frame) -->
          <div class="double-bezel-outer h-full w-full p-2.5 rounded-[2.5rem] bg-gradient-to-b from-white/15 via-white/5 to-white/10 dark:from-white/12 dark:via-white/5 dark:to-white/10 border border-white/20 dark:border-white/15 backdrop-blur-2xl shadow-[0_20px_50px_-10px_rgba(0,0,0,0.5)]">
            
            <!-- Inner Core with concentric mathematical radius calc(2.5rem - 0.625rem) -->
            <div class="double-bezel-inner relative h-full w-full rounded-[calc(2.5rem-0.625rem)] overflow-hidden bg-slate-950 border border-white/10 shadow-[inset_0_1px_1px_rgba(255,255,255,0.2)] flex flex-col justify-between">
              
              <!-- Artwork Image -->
              <Image
                src={cardFrontImg}
                alt="Card Front - Developer Portrait"
                width={720}
                height={1280}
                quality={90}
                class="absolute inset-0 w-full h-full object-cover object-center select-none pointer-events-none transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                loading="eager"
              />

              <!-- Specular Holographic Glare (moves with 3D tilt) -->
              <div class="glare-overlay absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-300"></div>

              <!-- Top Vignette & Header Metadata Badge -->
              <div class="relative z-10 p-4 bg-gradient-to-b from-black/80 via-black/40 to-transparent flex items-center justify-between">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-black/40 border border-white/15 backdrop-blur-md">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-[10px] uppercase tracking-[0.2em] font-mono text-white/90 font-medium">
                    {frontTag}
                  </span>
                </div>
                <div class="w-7 h-7 rounded-full bg-black/40 border border-white/15 backdrop-blur-md flex items-center justify-center text-[11px] font-mono text-white/80">
                  ✦
                </div>
              </div>

              <!-- Bottom Vignette & Island Flip Action Button (Button-in-Button) -->
              <div class="relative z-10 p-4 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex items-center justify-between">
                <div class="flex flex-col">
                  <span class="text-[11px] font-mono tracking-wider text-slate-300 uppercase">Persona ID</span>
                  <span class="text-sm font-semibold text-white tracking-tight">Kinyias // Core</span>
                </div>

                <!-- Floating Island Pill Button -->
                <div class="island-flip-btn inline-flex items-center gap-2 pl-3.5 pr-1.5 py-1.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-md transition-all duration-300 shadow-lg group/btn">
                  <span class="text-[11px] font-mono tracking-wider text-white font-medium uppercase">Flip</span>
                  <!-- Inner circle icon -->
                  <div class="w-6 h-6 rounded-full bg-white text-slate-950 flex items-center justify-center text-[10px] font-bold shadow-sm transition-transform duration-500 group-hover/btn:rotate-180">
                    ↻
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ================= BACK FACE (3D Universe & Tech Stack) ================= -->
        <div class="card-face card-face-back absolute inset-0">
          <!-- Outer Shell with Ambient Cyber Glow -->
          <div class="double-bezel-outer h-full w-full p-2.5 rounded-[2.5rem] bg-gradient-to-b from-cyan-400/20 via-white/5 to-cyan-500/20 border border-cyan-400/30 backdrop-blur-2xl shadow-[0_20px_50px_-10px_rgba(6,182,212,0.35)]">
            
            <!-- Inner Core -->
            <div class="double-bezel-inner relative h-full w-full rounded-[calc(2.5rem-0.625rem)] overflow-hidden bg-slate-950 border border-cyan-400/20 shadow-[inset_0_1px_1px_rgba(34,211,238,0.25)] flex flex-col justify-between">
              
              <!-- Artwork Image -->
              <Image
                src={cardBackImg}
                alt="Card Back - Creative Tech Universe"
                width={720}
                height={1280}
                quality={90}
                class="absolute inset-0 w-full h-full object-cover object-center select-none pointer-events-none transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                loading="eager"
              />

              <!-- Specular Holographic Glare -->
              <div class="glare-overlay absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-300"></div>

              <!-- Top Vignette & Header Metadata Badge -->
              <div class="relative z-10 p-4 bg-gradient-to-b from-black/80 via-black/40 to-transparent flex items-center justify-between">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-400/30 backdrop-blur-md">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                  <span class="text-[10px] uppercase tracking-[0.2em] font-mono text-cyan-200 font-medium">
                    {backTag}
                  </span>
                </div>
                <div class="w-7 h-7 rounded-full bg-cyan-950/60 border border-cyan-400/30 backdrop-blur-md flex items-center justify-center text-[11px] font-mono text-cyan-300">
                  ⚡
                </div>
              </div>

              <!-- Bottom Vignette & Island Return Button -->
              <div class="relative z-10 p-4 bg-gradient-to-t from-black/85 via-black/40 to-transparent flex items-center justify-between">
                <div class="flex flex-col">
                  <span class="text-[11px] font-mono tracking-wider text-cyan-300 uppercase">Universe Mode</span>
                  <span class="text-sm font-semibold text-white tracking-tight">Full-Stack & 3D</span>
                </div>

                <!-- Floating Island Pill Button -->
                <div class="island-flip-btn inline-flex items-center gap-2 pl-3.5 pr-1.5 py-1.5 rounded-full bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-400/40 backdrop-blur-md transition-all duration-300 shadow-lg group/btn">
                  <span class="text-[11px] font-mono tracking-wider text-cyan-100 font-medium uppercase">Back</span>
                  <div class="w-6 h-6 rounded-full bg-cyan-400 text-slate-950 flex items-center justify-center text-[10px] font-bold shadow-sm transition-transform duration-500 group-hover/btn:-rotate-180">
                    ↺
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>

      <!-- ================= SATELLITE FLOATING SOCIAL ICONS (GSAP-POWERED) ================= -->
      <div class="floating-socials-layer absolute inset-0 pointer-events-none select-none">
        
        <!-- 1. GitHub (Top-Left) -->
        <a
          href={resolvedSocials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub Profile (@kinyias)"
          class="floating-social-item social-github pointer-events-auto absolute -left-3 sm:-left-6 md:-left-8 top-16 sm:top-20 z-20 group/social focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-full"
        >
          <!-- Ambient Glow Orb -->
          <div class="social-glow absolute -inset-1 rounded-full blur-md bg-slate-400/40 dark:bg-white/20 opacity-30 pointer-events-none transition-all duration-300"></div>

          <!-- Dedicated Float Bobbing Element -->
          <div class="social-float-bob relative w-11 h-11 sm:w-12 sm:h-12">
            <!-- Glassmorphism Disc Badge -->
            <div class="social-badge-inner relative w-full h-full rounded-full bg-white/85 dark:bg-[#0c1220]/85 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-[0_8px_20px_-4px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_25px_-5px_rgba(0,0,0,0.7)] transition-all duration-300 group-hover/social:border-black/25 dark:group-hover/social:border-white/35 p-1.5 overflow-hidden flex items-center justify-center">
              <Image
                src={githubIcon}
                alt="GitHub"
                width={48}
                height={48}
                class="w-full h-full object-contain dark:invert transition-transform duration-300 group-hover/social:scale-110 pointer-events-none"
              />
            </div>
          </div>

          <!-- Micro Tooltip Pill -->
          <div class="social-tooltip hidden sm:flex absolute right-full mr-2.5 items-center gap-1 px-2.5 py-1 rounded-full bg-slate-950/90 dark:bg-white/95 text-white dark:text-slate-900 text-[10px] font-mono font-medium tracking-wide shadow-lg opacity-0 translate-x-1 pointer-events-none transition-all duration-200 group-hover/social:opacity-100 group-hover/social:translate-x-0 whitespace-nowrap border border-white/10 dark:border-slate-200/20">
            <span>GitHub</span>
            <span class="text-slate-400 dark:text-slate-500 font-normal">↗</span>
          </div>
        </a>

        <!-- 2. LinkedIn (Top-Right) -->
        <a
          href={resolvedSocials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn Profile"
          class="floating-social-item social-linkedin pointer-events-auto absolute -right-3 sm:-right-6 md:-right-8 top-32 sm:top-36 z-20 group/social focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-full"
        >
          <!-- Ambient Glow Orb -->
          <div class="social-glow absolute -inset-1 rounded-full blur-md bg-[#0077b5] opacity-30 pointer-events-none transition-all duration-300"></div>

          <!-- Dedicated Float Bobbing Element -->
          <div class="social-float-bob relative w-11 h-11 sm:w-12 sm:h-12">
            <!-- Glassmorphism Disc Badge -->
            <div class="social-badge-inner relative w-full h-full rounded-full bg-white/85 dark:bg-[#0c1220]/85 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-[0_8px_20px_-4px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_25px_-5px_rgba(0,0,0,0.7)] transition-all duration-300 group-hover/social:border-black/25 dark:group-hover/social:border-white/35 p-1 overflow-hidden flex items-center justify-center">
              <Image
                src={linkedinIcon}
                alt="LinkedIn"
                width={48}
                height={48}
                class="w-full h-full object-contain rounded-sm transition-transform duration-300 group-hover/social:scale-110 pointer-events-none"
              />
            </div>
          </div>

          <!-- Micro Tooltip Pill -->
          <div class="social-tooltip hidden sm:flex absolute left-full ml-2.5 items-center gap-1 px-2.5 py-1 rounded-full bg-slate-950/90 dark:bg-white/95 text-white dark:text-slate-900 text-[10px] font-mono font-medium tracking-wide shadow-lg opacity-0 -translate-x-1 pointer-events-none transition-all duration-200 group-hover/social:opacity-100 group-hover/social:translate-x-0 whitespace-nowrap border border-white/10 dark:border-slate-200/20">
            <span>LinkedIn</span>
            <span class="text-slate-400 dark:text-slate-500 font-normal">↗</span>
          </div>
        </a>

        <!-- 3. YouTube (Bottom-Left) -->
        <a
          href={resolvedSocials.youtube}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube Channel"
          class="floating-social-item social-youtube pointer-events-auto absolute -left-3 sm:-left-6 md:-left-8 bottom-36 sm:bottom-40 z-20 group/social focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded-full"
        >
          <!-- Ambient Glow Orb -->
          <div class="social-glow absolute -inset-1 rounded-full blur-md bg-red-500 opacity-30 pointer-events-none transition-all duration-300"></div>

          <!-- Dedicated Float Bobbing Element -->
          <div class="social-float-bob relative w-11 h-11 sm:w-12 sm:h-12">
            <!-- Glassmorphism Disc Badge -->
            <div class="social-badge-inner relative w-full h-full rounded-full bg-white/85 dark:bg-[#0c1220]/85 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-[0_8px_20px_-4px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_25px_-5px_rgba(0,0,0,0.7)] transition-all duration-300 group-hover/social:border-black/25 dark:group-hover/social:border-white/35 p-1 overflow-hidden flex items-center justify-center">
              <Image
                src={youtubeIcon}
                alt="YouTube"
                width={48}
                height={48}
                class="w-full h-full object-contain rounded-sm transition-transform duration-300 group-hover/social:scale-110 pointer-events-none"
              />
            </div>
          </div>

          <!-- Micro Tooltip Pill -->
          <div class="social-tooltip hidden sm:flex absolute right-full mr-2.5 items-center gap-1 px-2.5 py-1 rounded-full bg-slate-950/90 dark:bg-white/95 text-white dark:text-slate-900 text-[10px] font-mono font-medium tracking-wide shadow-lg opacity-0 translate-x-1 pointer-events-none transition-all duration-200 group-hover/social:opacity-100 group-hover/social:translate-x-0 whitespace-nowrap border border-white/10 dark:border-slate-200/20">
            <span>YouTube</span>
            <span class="text-slate-400 dark:text-slate-500 font-normal">↗</span>
          </div>
        </a>

        <!-- 4. Facebook (Bottom-Right) -->
        <a
          href={resolvedSocials.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook Profile"
          class="floating-social-item social-facebook pointer-events-auto absolute -right-3 sm:-right-6 md:-right-8 bottom-20 sm:bottom-24 z-20 group/social focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-full"
        >
          <!-- Ambient Glow Orb -->
          <div class="social-glow absolute -inset-1 rounded-full blur-md bg-blue-500 opacity-30 pointer-events-none transition-all duration-300"></div>

          <!-- Dedicated Float Bobbing Element -->
          <div class="social-float-bob relative w-11 h-11 sm:w-12 sm:h-12">
            <!-- Glassmorphism Disc Badge -->
            <div class="social-badge-inner relative w-full h-full rounded-full bg-white/85 dark:bg-[#0c1220]/85 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-[0_8px_20px_-4px_rgba(0,0,0,0.18)] dark:shadow-[0_10px_25px_-5px_rgba(0,0,0,0.7)] transition-all duration-300 group-hover/social:border-black/25 dark:group-hover/social:border-white/35 p-1 overflow-hidden flex items-center justify-center">
              <Image
                src={facebookIcon}
                alt="Facebook"
                width={48}
                height={48}
                class="w-full h-full object-contain rounded-full transition-transform duration-300 group-hover/social:scale-110 pointer-events-none"
              />
            </div>
          </div>

          <!-- Micro Tooltip Pill -->
          <div class="social-tooltip hidden sm:flex absolute left-full ml-2.5 items-center gap-1 px-2.5 py-1 rounded-full bg-slate-950/90 dark:bg-white/95 text-white dark:text-slate-900 text-[10px] font-mono font-medium tracking-wide shadow-lg opacity-0 -translate-x-1 pointer-events-none transition-all duration-200 group-hover/social:opacity-100 group-hover/social:translate-x-0 whitespace-nowrap border border-white/10 dark:border-slate-200/20">
            <span>Facebook</span>
            <span class="text-slate-400 dark:text-slate-500 font-normal">↗</span>
          </div>
        </a>

      </div>
    </div>

    <!-- Dynamic Ground Contact Shadow (Breathing with levitation) -->
    <div class="card-ambient-shadow mx-auto -mt-3 w-48 sm:w-56 h-6 rounded-[100%] bg-black/60 dark:bg-cyan-500/15 blur-xl pointer-events-none transition-all duration-700"></div>

    <!-- Micro Instruction Label -->
    <div class="mt-4 text-center">
      <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-slate-400 dark:text-slate-500 tracking-wider">
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-slate-200 dark:bg-white/10 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-white/10">CLICK</kbd>
        <span>to flip 3D card</span>
      </span>
    </div>
  </div>
</div>

<style>
  /* 3D Hardware Accelerated Staging */
  .perspective-stage {
    perspective: 1400px;
  }

  .floating-anchor {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .card-3d-core {
    transform-style: preserve-3d;
    will-change: transform;
    transition: box-shadow 0.5s ease;
  }

  .floating-socials-layer {
    transform-style: preserve-3d;
  }

  .floating-social-item {
    transform-style: preserve-3d;
    will-change: transform;
    transform: translateZ(40px);
  }

  .social-float-bob {
    transform-style: preserve-3d;
    will-change: transform;
  }

  .card-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .card-face-front {
    transform: rotateY(0deg) translateZ(1px);
    z-index: 5;
  }

  .card-face-back {
    transform: rotateY(180deg) translateZ(1px);
    z-index: 1;
  }

  /* Holographic Sheen */
  .glare-overlay {
    background: radial-gradient(
      circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.45) 0%,
      rgba(255, 255, 255, 0.1) 40%,
      transparent 70%
    );
    mix-blend-mode: overlay;
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initFlipCard() {
    const roots = document.querySelectorAll('.card-3d-root');
    
    roots.forEach((root) => {
      const rootEl = root as HTMLElement;
      // Guard against duplicate initialization
      if (rootEl.dataset.initialized === 'true') return;
      rootEl.dataset.initialized = 'true';

      const floatingAnchor = rootEl.querySelector('.floating-anchor') as HTMLElement;
      const cardCore = rootEl.querySelector('.card-3d-core') as HTMLElement;
      const ambientShadow = rootEl.querySelector('.card-ambient-shadow') as HTMLElement;
      const glares = rootEl.querySelectorAll('.glare-overlay') as NodeListOf<HTMLElement>;
      const socialItems = rootEl.querySelectorAll('.floating-social-item') as NodeListOf<HTMLElement>;
      const socialBobs = rootEl.querySelectorAll('.social-float-bob') as NodeListOf<HTMLElement>;

      if (!floatingAnchor || !cardCore) return;

      const frontFace = rootEl.querySelector('.card-face-front') as HTMLElement;
      const backFace = rootEl.querySelector('.card-face-back') as HTMLElement;

      let isFlipped = rootEl.dataset.initialFlipped === 'true';

      // Apply initial flip state if configured
      if (isFlipped) {
        gsap.set(cardCore, { rotationY: 180 });
        if (backFace) backFace.style.zIndex = '10';
        if (frontFace) frontFace.style.zIndex = '1';
      }

      // ================= 1. CARD MAIN LEVITATION (Active & Majestic Sine Wave) =================
      const cardFloatTween = gsap.to(floatingAnchor, {
        y: -38,
        rotationZ: 1.8,
        duration: 2.8,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });

      // Ground contact shadow breathes in reverse phase with card altitude
      const shadowTween = gsap.to(ambientShadow, {
        scaleX: 0.55,
        scaleY: 0.55,
        opacity: 0.15,
        duration: 2.8,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
      });

      // ================= 2. SOCIAL SATELLITES INDEPENDENT FLOATING LOOPS =================
      // Entrance spring pop
      gsap.from(socialItems, {
        scale: 0,
        autoAlpha: 0,
        y: 20,
        duration: 0.6,
        stagger: 0.08,
        ease: 'back.out(1.8)',
        delay: 0.1,
        clearProps: 'scale,autoAlpha',
      });

      // Dedicated infinite floating physics on inner .social-float-bob (never killed by mouse hover/tilt)
      const bobConfigs = [
        { y: -20, x: 8, rotation: 8, duration: 2.5, delay: 0 },    // GitHub
        { y: 22, x: -9, rotation: -9, duration: 3.0, delay: 0.3 }, // LinkedIn
        { y: -18, x: 9, rotation: -7, duration: 2.7, delay: 0.6 }, // YouTube
        { y: 20, x: -8, rotation: 8, duration: 3.2, delay: 0.2 },  // Facebook
      ];

      socialBobs.forEach((bob, i) => {
        const cfg = bobConfigs[i] || { y: -16, x: 6, rotation: 6, duration: 2.8, delay: 0 };
        gsap.to(bob, {
          y: cfg.y,
          x: cfg.x,
          rotation: cfg.rotation,
          duration: cfg.duration,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
          delay: cfg.delay,
        });
      });

      // ================= 3. 3D INTERACTIVE TILT & PARALLAX =================
      const isMobile = window.innerWidth < 768;

      const onMouseMove = (e: MouseEvent) => {
        const rect = floatingAnchor.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const xPct = (x / rect.width - 0.5) * 2; // -1 to 1
        const yPct = (y / rect.height - 0.5) * 2; // -1 to 1

        // Specular glare sheen
        glares.forEach((glare) => {
          glare.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
          glare.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);
          glare.style.opacity = '1';
        });

        // 3D Card tilt
        const baseRotationY = isFlipped ? 180 : 0;
        gsap.to(cardCore, {
          rotationY: baseRotationY + xPct * (isMobile ? 8 : 14),
          rotationX: -yPct * (isMobile ? 8 : 14),
          duration: 0.3,
          ease: 'power1.out',
          overwrite: 'auto',
        });

        // 3D Parallax offset on outer social items
        const parallaxMultipliers = [20, -18, 16, -20];
        const zDepths = [60, 70, 55, 65];
        socialItems.forEach((item, idx) => {
          const mult = parallaxMultipliers[idx] || 18;
          const zVal = zDepths[idx] || 60;
          gsap.to(item, {
            x: xPct * mult,
            y: yPct * (mult * 0.7),
            z: zVal,
            duration: 0.35,
            ease: 'power1.out',
            overwrite: 'auto',
          });
        });
      };

      const onMouseLeave = () => {
        glares.forEach((glare) => {
          glare.style.opacity = '0';
        });

        // Reset card tilt
        gsap.to(cardCore, {
          rotationX: 0,
          rotationY: isFlipped ? 180 : 0,
          duration: 0.6,
          ease: 'power2.out',
          overwrite: 'auto',
        });

        // Reset social items parallax
        socialItems.forEach((item) => {
          gsap.to(item, {
            x: 0,
            y: 0,
            z: 40,
            duration: 0.6,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        });
      };

      // ================= 4. CARD 3D FLIP =================
      const performFlip = () => {
        isFlipped = !isFlipped;
        const targetY = isFlipped ? 180 : 0;

        const tl = gsap.timeline({ defaults: { overwrite: 'auto' } });

        // Satellite impulse pop wave
        tl.to(
          socialItems,
          {
            scale: 1.18,
            rotation: '+=15',
            duration: 0.2,
            yoyo: true,
            repeat: 1,
            stagger: 0.05,
            ease: 'power2.out',
          },
          0
        );

        // Card flip animation
        tl.to(
          cardCore,
          {
            scale: 1.05,
            duration: 0.25,
            ease: 'power1.out',
          },
          0
        )
        .to(
          cardCore,
          {
            rotationY: targetY,
            duration: 0.85,
            ease: 'power2.inOut',
            onUpdate: function () {
              const cur = Math.abs(((gsap.getProperty(cardCore, 'rotationY') as number) || 0) % 360);
              const isBack = cur > 90 && cur < 270;
              if (isBack) {
                if (backFace) backFace.style.zIndex = '10';
                if (frontFace) frontFace.style.zIndex = '1';
              } else {
                if (frontFace) frontFace.style.zIndex = '10';
                if (backFace) backFace.style.zIndex = '1';
              }
            },
          },
          0
        )
        .to(
          cardCore,
          {
            scale: 1,
            duration: 0.45,
            ease: 'back.out(1.5)',
          },
          '-=0.25'
        );
      };

      floatingAnchor.addEventListener('mousemove', onMouseMove);
      floatingAnchor.addEventListener('mouseleave', onMouseLeave);
      floatingAnchor.addEventListener('click', performFlip);

      // ================= 5. INDIVIDUAL SOCIAL HOVER & CLICK =================
      socialItems.forEach((item) => {
        const glow = item.querySelector('.social-glow');

        item.addEventListener('mouseenter', () => {
          gsap.to(item, {
            scale: 1.22,
            z: 85,
            duration: 0.3,
            ease: 'back.out(2)',
            overwrite: 'auto',
          });
          if (glow) {
            gsap.to(glow, {
              scale: 1.4,
              opacity: 0.85,
              duration: 0.3,
              ease: 'power2.out',
            });
          }
        });

        item.addEventListener('mouseleave', () => {
          gsap.to(item, {
            scale: 1,
            z: 40,
            duration: 0.4,
            ease: 'power2.out',
            overwrite: 'auto',
          });
          if (glow) {
            gsap.to(glow, {
              scale: 1,
              opacity: 0.3,
              duration: 0.4,
              ease: 'power2.out',
            });
          }
        });

        // Click on icon opens social page, does not flip card
        item.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      });

      // Cleanup on page transitions
      document.addEventListener('astro:before-swap', () => {
        rootEl.dataset.initialized = 'false';
        cardFloatTween.kill();
        shadowTween.kill();
        floatingAnchor.removeEventListener('mousemove', onMouseMove);
        floatingAnchor.removeEventListener('mouseleave', onMouseLeave);
        floatingAnchor.removeEventListener('click', performFlip);
      }, { once: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFlipCard);
  } else {
    initFlipCard();
  }
  document.addEventListener('astro:page-load', initFlipCard);
</script>
