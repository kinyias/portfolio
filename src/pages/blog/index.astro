---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import FeaturedCard from '../../components/blog/FeaturedCard.astro';
import BlogSearchFilter from '../../components/blog/BlogSearchFilter.astro';
import { fetchBlogPosts, fetchBlogCategories } from '../../utils/blogApi';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

// Fetch data from Turso/backend with local fallbacks
const { data: posts, pagination } = await fetchBlogPosts({ lang, limit: 30 });
const categories = await fetchBlogCategories(lang);

// Split featured post and remaining posts
const featuredPost = posts.find((p) => p.featured) || (posts.length > 0 ? posts[0] : null);
const standardPosts = posts.filter((p) => p.id !== featuredPost?.id);
---

<BlogLayout
  title="Engineering & Tech Blog — Thái Tín Khang (kinyias)"
  description="Technical deep dives on modern web architectures, distributed edge databases with Turso libSQL, and AI engineering with Gemini."
>
  <div class="w-full py-2 sm:py-4">
    <!-- Header Section -->
    <section class="mb-12 max-w-3xl">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wide bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 mb-4">
        <span class="inline-block w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
        <span>{t('blog.badge')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-4">
        {t('blog.title')}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed text-pretty">
        {t('blog.subtitle')}
      </p>
    </section>

    <!-- Featured Post Spotlight -->
    {
      featuredPost && (
        <section class="mb-14">
          <FeaturedCard post={featuredPost} lang={lang} />
        </section>
      )
    }

    <!-- Search & Filter Controls -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          {t('blog.latestTitle')}
        </h2>
        <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      <BlogSearchFilter categories={categories} lang={lang} totalPosts={posts.length} />

      <!-- Articles Grid -->
      <div id="blog-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {
          posts.map((post) => (
            <BlogCard post={post} lang={lang} />
          ))
        }
      </div>

      <!-- Empty State -->
      <div
        id="blog-empty-state"
        class="hidden py-16 px-6 text-center rounded-2xl border border-dashed border-black/10 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]"
      >
        <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-blue-500/10 text-blue-500 flex items-center justify-center text-xl">
          🔍
        </div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white mb-1">
          {t('blog.noResults')}
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 max-w-sm mx-auto">
          Try searching for different keywords, topics, or clearing active filters.
        </p>
        <button
          type="button"
          id="reset-filters-btn"
          class="px-4 py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white transition-colors cursor-pointer"
        >
          {t('blog.noResultsReset')}
        </button>
      </div>
    </section>
  </div>
</BlogLayout>
