---
import LanguagePicker from '../components/LanguagePicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, type Lang } from '../i18n/utils';
import type { BlogAlternate } from '../utils/blogApi';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  coverImage?: string | null;
  publishedTime?: string | null;
  authorName?: string;
  alternate?: BlogAlternate | null;
  isArticle?: boolean;
}

const {
  title = 'Blog — Thái Tín Khang (kinyias)',
  description = 'Technical articles on modern web engineering, distributed databases (Turso libSQL), and AI architectures.',
  coverImage,
  publishedTime,
  authorName = 'Thái Tín Khang',
  alternate,
  isArticle = false,
} = Astro.props;

const currentLocale = Astro.currentLocale ?? 'en';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Destination for direct language toggle if alternate translation exists
const targetLang: Lang = lang === 'en' ? 'vi' : 'en';
let directAlternateUrl: string | null = null;
if (alternate && alternate.slug) {
  directAlternateUrl = alternate.lang === 'vi' ? `/vi/blog/${alternate.slug}` : `/blog/${alternate.slug}`;
}
---

<!doctype html>
<html lang={currentLocale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- OpenGraph / Social Metadata -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {coverImage && <meta property="og:image" content={coverImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="article:author" content={authorName} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme') || 'system';
        const isDark =
          theme === 'dark' ||
          (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);

        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <!-- Top Reading Progress Indicator (Visible on Articles) -->
    {
      isArticle && (
        <div id="reading-progress-track" class="fixed top-0 left-0 right-0 h-[3px] bg-transparent z-[60] pointer-events-none">
          <div
            id="reading-progress-bar"
            class="h-full bg-gradient-to-r from-blue-600 via-indigo-500 to-emerald-400 w-0 transition-all duration-75"
          />
        </div>
      )
    }

    <!-- Top-Left Floating Home Navigation Pill -->
    <div class="fixed top-4 left-4 sm:top-6 sm:left-6 z-50 pointer-events-none">
      <a
        href={translatePath('/')}
        class="pointer-events-auto inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/80 dark:bg-[#0b0f19]/80 backdrop-blur-2xl border border-black/5 dark:border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.08)] dark:shadow-[0_12px_35px_rgba(0,0,0,0.6)] text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 hover:border-blue-500/30 transition-all duration-200 hover:scale-[1.03] active:scale-95 group"
        title={lang === 'vi' ? 'Quay lại Trang chủ Portfolio' : 'Back to Portfolio Home'}
      >
        <span class="transition-transform group-hover:-translate-x-0.5">←</span>
        <span>{lang === 'vi' ? 'Trang chủ' : 'Home'}</span>
      </a>
    </div>

    <!-- Corner Floating Utility Dock (Matching Home Page Spec) -->
    <header class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50 pointer-events-none">
      <div
        class="corner-dock pointer-events-auto flex items-center gap-1.5 p-1 rounded-full bg-white/75 dark:bg-[#0b0f19]/80 backdrop-blur-2xl border border-black/5 dark:border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.08)] dark:shadow-[0_12px_35px_rgba(0,0,0,0.6)] transition-all duration-300 hover:shadow-[0_12px_35px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_15px_40px_rgba(0,0,0,0.75)]"
      >
        {/* Direct Alternate Language Switcher on Article */}
        {
          directAlternateUrl ? (
            <>
              <a
                href={directAlternateUrl}
                class="px-2.5 py-1 rounded-full text-xs font-mono font-medium text-blue-600 dark:text-blue-400 hover:bg-blue-500/10 transition-colors"
                title={`Đọc bản tiếng ${targetLang.toUpperCase()}`}
              >
                {targetLang.toUpperCase()}
              </a>
              <span class="w-[1px] h-3.5 bg-black/10 dark:bg-white/10" aria-hidden="true" />
            </>
          ) : null
        }

        <ThemeToggle />
        <span class="w-[1px] h-3.5 bg-black/10 dark:bg-white/10" aria-hidden="true" />
        <LanguagePicker />
      </div>
    </header>

    <!-- Main Content Staging (Matching Home Page Rhythm) -->
    <main class="page-content">
      <slot />
    </main>

    <!-- Site Footer (Matching Home Page) -->
    <footer class="site-footer">
      <div class="footer-container">
        <p>
          &copy; {new Date().getFullYear()} Thái Tín Khang (kinyias). {t('footer.rights')}
        </p>
      </div>
    </footer>

    <!-- Client-side Scripts -->
    <script>
      // Reading Progress Bar handler
      const bar = document.getElementById('reading-progress-bar');
      if (bar) {
        const updateProgress = () => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight > 0) {
            const progress = (window.scrollY / totalHeight) * 100;
            bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
          }
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // One-click Code Copy Button Handler
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const copyBtn = target?.closest('.copy-code-btn') as HTMLButtonElement | null;
        if (!copyBtn) return;

        const rawCode = copyBtn.getAttribute('data-code');
        if (!rawCode) return;

        const decoded = decodeURIComponent(rawCode);
        navigator.clipboard.writeText(decoded).then(() => {
          const label = copyBtn.querySelector('.copy-label');
          if (label) {
            const originalText = label.textContent;
            label.textContent = 'Copied!';
            copyBtn.classList.add('text-emerald-400');
            setTimeout(() => {
              label.textContent = originalText;
              copyBtn.classList.remove('text-emerald-400');
            }, 2000);
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    font-family:
      'Plus Jakarta Sans',
      system-ui,
      -apple-system,
      sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  /* Main Page Content - Clean vertical rhythm matching Home Page */
  .page-content {
    position: relative;
    z-index: 10;
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding: 3rem 1.5rem 4rem;
  }

  .site-footer {
    border-top: 1px solid var(--border-color);
    padding: 1.75rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.875rem;
    transition: border-color 0.25s ease;
    position: relative;
    z-index: 10;
  }

  @media (max-width: 640px) {
    .page-content {
      padding: 4rem 1rem 3rem;
    }
  }
</style>
