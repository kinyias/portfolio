---
import LanguagePicker from "../components/LanguagePicker.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import BinaryBackground from "../components/BinaryBackground.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Portfolio", description = "Personal Portfolio Website" } =
  Astro.props;
const currentLocale = Astro.currentLocale ?? "en";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono (Agency-tier typography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-FOUC theme initialization script -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem("theme") || "system";
        const isDark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = isDark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <!-- Waving Binary Background with Proximity Bloom & GSAP Animation -->
    <BinaryBackground baseOpacity={0.22} hoverOpacity={0.88} waveRadius={360} />

    <!-- Corner Floating Utility Dock (Minimalist Developer Portfolio Spec) -->
    <header
      class="fixed top-4 right-4 sm:top-6 sm:right-6 z-50 pointer-events-none"
    >
      <div
        class="corner-dock pointer-events-auto flex items-center gap-1.5 p-1 rounded-full bg-white/75 dark:bg-[#0b0f19]/80 backdrop-blur-2xl border border-black/5 dark:border-white/10 shadow-[0_8px_30px_rgba(0,0,0,0.08)] dark:shadow-[0_12px_35px_rgba(0,0,0,0.6)] transition-all duration-300 hover:shadow-[0_12px_35px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_15px_40px_rgba(0,0,0,0.75)]"
      >
        <ThemeToggle />
        <span
          class="w-[1px] h-3.5 bg-black/10 dark:bg-white/10"
          aria-hidden="true"></span>
        <LanguagePicker />
      </div>
    </header>

    <!-- Main Content Staging -->
    <main class="page-content">
      <slot />
    </main>

    <footer class="site-footer hidden">
      <div class="footer-container">
        <p>
          &copy; {new Date().getFullYear()} Thái Tín Khang (kinyias). {
            t("footer.rights")
          }
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    font-family:
      "Plus Jakarta Sans",
      system-ui,
      -apple-system,
      sans-serif;
  }

  /* Main Page Content - Clean vertical rhythm without bulky header */
  .page-content {
    position: relative;
    z-index: 10;
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding: 0rem 1.5rem;
  }

  .site-footer {
    border-top: 1px solid var(--border-color);
    padding: 1.75rem 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.875rem;
    transition: border-color 0.25s ease;
  }

  @media (max-width: 640px) {
    .page-content {
      padding: 3rem 1rem 2rem;
    }
  }
</style>
